{
  "name": "deepsteve",
  "version": "0.24.1",
  "private": true,
  "description": "A web UI for your Claude Code and Codex agents. It runs on your machine, in plain HTML, CSS and JavaScript — so your agents can build your dev tools.",
  "license": "MIT",
  "author": "Fncore, Inc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepsteve/deepsteve.git"
  },
  "homepage": "https://deepsteve.com",
  "bugs": {
    "url": "https://github.com/deepsteve/deepsteve/issues"
  },
  "main": "server.js",
  "bin": {
    "deepsteve": "bin/deepsteve.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "frontend",
    "pty",
    "terminal",
    "agents"
  ],
  "files": [
    "/*.js",
    "bin/",
    "engines/",
    "public/",
    "mods/",
    "skills/",
    "!skills/release.md",
    "themes/",
    "service.sh",
    "status.sh",
    "uninstall.sh"
  ],
  "scripts": {
    "test": "sh test/run-integration.sh",
    "test:unit": "node --test test/unit/*.test.js",
    "test:standalone": "sh test/run-standalone.sh",
    "test:docker": "docker compose -f test/docker-compose.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:docker:clean": "docker compose -f test/docker-compose.yml down -v --rmi local",
    "test:install": "bash release.sh && docker compose -f test/docker-compose.install.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:install:clean": "docker compose -f test/docker-compose.install.yml down -v --rmi local",
    "test:npm": "docker compose -f test/docker-compose.npm.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:npm:clean": "docker compose -f test/docker-compose.npm.yml down -v --rmi local",
    "test:docker:public": "docker compose -f test/docker-compose.public.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:docker:public:clean": "docker compose -f test/docker-compose.public.yml down -v --rmi local"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/headless": "6.0.0",
    "express": "^4.22.2",
    "node-pty": "^1.0.0",
    "selfsigned": "^5.0.0",
    "ws": "^8.20.1",
    "zod": "^3.24.0"
  }
}
