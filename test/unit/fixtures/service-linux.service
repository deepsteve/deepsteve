[Unit]
Description=deepsteve daemon

[Service]
Type=simple
ExecStart="{{NODE}}" "{{HOME}}/.deepsteve/server.js"
WorkingDirectory={{HOME}}/.deepsteve
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DEEPSTEVE_BIND=127.0.0.1
Environment=DEEPSTEVE_LOG_DIR={{HOME}}/.local/share/deepsteve/logs
Environment=PATH={{HOME}}/.deepsteve/node/bin:{{HOME}}/.local/bin:{{NODEDIR}}:{{NODEDIR}}:/usr/bin:/bin:/usr/sbin:/sbin
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30
SyslogIdentifier=deepsteve
StandardOutput=append:{{HOME}}/.local/share/deepsteve/logs/deepsteve.log
StandardError=append:{{HOME}}/.local/share/deepsteve/logs/deepsteve.error.log

[Install]
WantedBy=default.target
