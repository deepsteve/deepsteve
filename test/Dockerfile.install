# Installs from a locally-generated install.sh (built by release.sh).
# Tests the install flow before publishing — catches install script bugs
# that Dockerfile (repo source) won't find and Dockerfile.public can't
# test until the script is already live.
FROM node:22-bookworm

# tmux: a DECLARED dependency off macOS since #621, so install.sh refuses to run without
#   it here. Satisfying a declared dependency in the image is the point — this is also
#   what lets the suite stop skipping the tmux-engine tests.
# NO zsh, deliberately (#621): the daemon resolves the login shell now ($SHELL, else the
#   passwd entry, else zsh/bash/sh) instead of spawning a literal `zsh -l`. Root's passwd
#   shell here is /bin/bash — exactly the fallback a real Linux box takes — so leaving
#   zsh out makes this image the regression test for that.
# curl: used by docker-compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl tmux && rm -rf /var/lib/apt/lists/*

# Install via locally-generated install.sh.
#
# launchctl/systemctl are RECORDING stubs, not `exit 0` no-ops (#621). The Linux arm of
# install.sh had never actually been checked: with a silent stub, an installer that wrote
# no unit and started nothing looked exactly like one that worked. Now the build asserts
# the unit was written and that daemon-reload and `enable --now` were really issued.
COPY install.sh /tmp/install.sh
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/launchctl && chmod +x /usr/local/bin/launchctl \
 && printf '#!/bin/sh\necho "systemctl $*" >> /tmp/systemctl.log\nexit 0\n' > /usr/local/bin/systemctl \
 && chmod +x /usr/local/bin/systemctl \
 && bash /tmp/install.sh \
 && test -s /root/.deepsteve/server.js \
 && test -s /root/.config/systemd/user/deepsteve.service \
 && grep -q 'KillMode=process' /root/.config/systemd/user/deepsteve.service \
 && grep -q 'daemon-reload' /tmp/systemctl.log \
 && grep -q 'enable --now deepsteve' /tmp/systemctl.log \
 && test -s /root/.deepsteve/service.sh \
 && test -x /root/.deepsteve/status.sh \
 && test ! -x /root/.deepsteve/service.sh

WORKDIR /root/.deepsteve

EXPOSE 3000

CMD ["node", "server.js"]
